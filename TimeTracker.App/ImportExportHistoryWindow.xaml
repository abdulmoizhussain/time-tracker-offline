<Window x:Class="TimeTracker.App.ImportExportHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TimeTracker.App.Converters"
        Title="Import/Export History"
        Height="560"
        Width="980"
        MinWidth="760"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ScaledWindowStyle}">
    <Window.Resources>
        <conv:DateGroupLabelConverter x:Key="DateGroupLabelConverter" />
    </Window.Resources>
    <Border Style="{StaticResource SurfaceStyle}" Margin="16"><Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Import/Export History" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="16,4" Margin="16,0,0,0" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding Records}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="50" DisplayMemberBinding="{Binding Id}" />
                    <GridViewColumn Header="Time" Width="140" DisplayMemberBinding="{Binding OccurredLocal, StringFormat='{}{0:g}'}" />
                    <GridViewColumn Header="Action" Width="80" DisplayMemberBinding="{Binding ActionType}" />
                    <GridViewColumn Header="Count" Width="60" DisplayMemberBinding="{Binding ItemCount}" />
                    <GridViewColumn Header="First Entry" Width="160" DisplayMemberBinding="{Binding FirstEntryDescription}" />
                    <GridViewColumn Header="First Start" Width="140" DisplayMemberBinding="{Binding FirstEntryStartLocal, StringFormat='{}{0:g}'}" />
                    <GridViewColumn Header="Last Entry" Width="160" DisplayMemberBinding="{Binding LastEntryDescription}" />
                    <GridViewColumn Header="Last Start" Width="140" DisplayMemberBinding="{Binding LastEntryStartLocal, StringFormat='{}{0:g}'}" />
                </GridView>
            </ListView.View>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, Converter={StaticResource DateGroupLabelConverter}}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Margin="4,8,0,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>

        <TextBlock Grid.Row="2" Text="{Binding SummaryText}" Margin="0,8,0,0" />
    </Grid></Border>
</Window>
