<Window x:Class="TimeTracker.App.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual"
        Deactivated="OnDeactivated"
        Style="{StaticResource ScaledWindowStyle}">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="10"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="TimeTracker" Style="{StaticResource SectionTitleStyle}" />
                <Button Content="×" AutomationProperties.Name="Close popup" ToolTip="Close popup" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="6,0" MinHeight="26" Click="OnCloseClick" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding RunningElapsedText}"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="34"
                       Typography.NumeralAlignment="Tabular"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0" />

            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock Text="{Binding RunningStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" MaxHeight="120" ToolTip="{Binding RunningStatusText}" />
            </DockPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                <Button AutomationProperties.Name="Start timer" Style="{StaticResource PrimaryButtonStyle}" Click="OnStartStopClick"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlayGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="12" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="Start" /></StackPanel></Button>
                <Button Content="Open App" Padding="16,6" Margin="8,0,0,0" Click="OnOpenAppClick" />
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button AutomationProperties.Name="Stop timer" Style="{StaticResource StopButtonStyle}" Click="OnStartStopClick"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource StopGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="Stop" /></StackPanel></Button>
                <Button Content="Open App" Padding="16,6" Margin="8,0,0,0" Click="OnOpenAppClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
