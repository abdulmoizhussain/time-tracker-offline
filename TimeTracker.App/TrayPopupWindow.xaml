<Window x:Class="TimeTracker.App.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="280"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual"
        Deactivated="OnDeactivated"
        Style="{StaticResource ScaledWindowStyle}">
    <Border Background="#FF1E1E1E"
            BorderBrush="#FF333333"
            BorderThickness="1"
            CornerRadius="8"
            Margin="10"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="Time Tracker" Foreground="White" FontWeight="Bold" />
                <Button Content="✕" HorizontalAlignment="Right" Foreground="White" Background="Transparent" BorderThickness="0" Padding="4,0" Click="OnCloseClick" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding RunningElapsedText}"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0" />

            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                <Ellipse Width="10" Height="10" Fill="{Binding IsTimerRunning, Converter={StaticResource RunningForegroundConverter}}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding RunningStatusText}" TextWrapping="Wrap" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
            </DockPanel>

            <StackPanel Grid.Row="3" Margin="0,12,0,0"
                        Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Running task description" Foreground="White" Margin="0,0,0,4" />
                <TextBox Text="{Binding RunningDescription, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="TrayRunningDescriptionTextBox"
                     Foreground="White"
                     Background="#FF333333"
                     BorderThickness="0"
                     Padding="8,4"
                     TextWrapping="Wrap">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SaveRunningDescriptionCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Save description" Command="{Binding SaveRunningDescriptionCommand}"
                        AutomationProperties.AutomationId="TraySaveRunningDescriptionButton" Margin="0,6,0,0" Padding="8,4" />
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                <Button Content="Start" Padding="16,6" Click="OnStartStopClick" />
                <Button Content="Open App" Padding="16,6" Margin="8,0,0,0" Click="OnOpenAppClick" />
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Content="Stop" Padding="16,6" Click="OnStartStopClick" />
                <Button Content="Open App" Padding="16,6" Margin="8,0,0,0" Click="OnOpenAppClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
