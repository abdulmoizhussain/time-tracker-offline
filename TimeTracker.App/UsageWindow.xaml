<Window x:Class="TimeTracker.App.UsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time Tracker Usage"
        Width="660" Height="650" MinWidth="480" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource ScaledWindowStyle}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource SurfaceStyle}" Margin="16"><DockPanel>
        <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True"
                HorizontalAlignment="Right" Padding="20,6" Margin="0,12,0,0"
                AutomationProperties.AutomationId="CloseUsageButton" Click="OnCloseClick" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Using TimeTracker" Style="{StaticResource SectionTitleStyle}" FontSize="24" />
                <TextBlock Text="Duration formats: Clock pattern" Style="{StaticResource SectionHeading}" />
                <TextBlock Text="Whole numbers mean minutes. A decimal point or comma means hours. With two colon-separated parts, use minutes:seconds; with three, use hours:minutes:seconds." Margin="0,0,0,8" />
                <Grid AutomationProperties.AutomationId="DurationFormatsTable">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Input" FontWeight="SemiBold" Margin="0,0,24,6" />
                    <TextBlock Grid.Column="1" Text="Duration" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="1" Text="34" Margin="0,0,24,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="34 minutes" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="2" Text="33:33" Margin="0,0,24,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="33 minutes, 33 seconds" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="3" Text="33:" Margin="0,0,24,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="33 minutes" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="4" Text=":33" Margin="0,0,24,4" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="33 seconds" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="5" Text="1:02:30" Margin="0,0,24,4" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="1 hour, 2 minutes, 30 seconds" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="6" Text="1.5" Margin="0,0,24,4" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="1 hour, 30 minutes (90 minutes)" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="7" Text="5.3" Margin="0,0,24,4" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="5 hours, 18 minutes" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="8" Text="2,25" Margin="0,0,24,4" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="2 hours, 15 minutes" Margin="0,0,0,4" />
                </Grid>
                <TextBlock Text="For example, 1:30 means 1 minute, 30 seconds. For 1 hour, 30 minutes, enter 1:30:00 or 1.5. Manual entries must be from 1 second to 24 hours. Seconds must be 00–59; in hours:minutes:seconds, minutes must also be 00–59. Empty, negative, malformed, and overflowing input is rejected; whole seconds are stored." Margin="0,8,0,0" />
                <TextBlock Text="Duration formats: Unit pattern" Style="{StaticResource SectionHeading}" />
                <TextBlock Text="Use whole numbers labeled h (hours), m (minutes), and s (seconds), in that order; omitted units are zero. Examples: 1h 2m 3s → 01:02:03; 1h 55m → 01:55:00; 59m 59s → 00:59:59; 90m → 01:30:00; 1000s → 00:16:40; 600s → 00:10:00. Spaces between units are optional; uppercase units also work." />
                <TextBlock Text="Only a single unit may overflow: 90m is valid, but 1h 90m is invalid. With multiple units, minutes and seconds must each be 0–59. Every number needs a unit: 1m 2, 1h 123, -2s, and 2 2m are invalid. Repeated or reordered units and decimal units are invalid. Without units, use the Clock pattern above: 29 still means 29 minutes." Margin="0,8,0,0" />
                <TextBlock Text="Both Initial duration and manual Duration format valid input as hh:mm:ss when you click away, press Tab, or press Enter. Invalid text stays visible with an error. Enter in Initial duration also starts the timer when its description has text; Enter in manual Duration formats only. Initial duration allows zero or blank (start from zero); manual duration must be at least one second. Initial duration has a maximum of 23:59:59; manual duration allows up to 24:00:00." Margin="0,8,0,0" />
                <TextBlock Text="Existing and imported entries may contain durations over 24 hours. Their full hours are shown in the list, totals, and exports without wrapping. The manual input limit does not cap or change those stored values." Margin="0,8,0,0" />
                <TextBlock Text="Manual entries" Style="{StaticResource SectionHeading}" />
                <TextBlock Text="Initial timer duration: beside the timer description, enter an optional duration using the formats above (0–23:59:59). Blank starts from zero. The timer continues from that duration; Created is the actual save time. Start may temporarily fall on the previous day, pending author review." TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="Description suggestions: release Down-arrow in an empty description field for the last five entries. Use Up/Down to highlight and Enter to fill that field, or Escape to dismiss. The same keys work with typed search results. In the timer description, Enter starts the timer when the description has text and suggestions are closed; if suggestions are open, accept one first, then press Enter again to start. Enter in Initial duration also starts with a nonblank description and a valid duration." TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="Unfinished task: on unlock or app startup, choose Continue, Stop at recorded time, or Stop now. Continue keeps counting the interruption. After abrupt shutdown, last recorded activity is a fallback rather than an exact shutdown time. Closing the main window only hides it to the tray." TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="Add by duration: enter a description, choose a Start Date, and enter the duration. Click Add. End uses the current clock time on the selected date, with Start that duration earlier. If Start would precede midnight, Start becomes midnight and End is midnight plus the duration. Exactly 24 hours ends at midnight the next day; longer durations are invalid." />
                <TextBlock Text="Add by start and end time: enter a description and Start Date, then enter either HH:mm or HH:mm:ss (24-hour time, two digits per component), such as 09:00 or 09:00:00. Two parts always mean hours and minutes: 22:45 means 22 hours, 45 minutes. A single number without a colon is invalid. The end must be after the start on the same day. Click + Add with Range. Each row keeps its own draft. Manual Duration begins empty with a 00:00:00 placeholder; Start Time and End Time begin empty with HH:mm placeholders. Hover either time label or input for format hints. Placeholders are not saved values." Margin="0,8,0,0" />
                <TextBlock Text="Single-click selects an entry without changing your manual-entry drafts. Select description text and press Ctrl+C to copy. Double-click outside the description or right-click → Edit entry opens Edit entry for running and completed entries. Its Description searches matching existing descriptions while typing; Up/Down highlights, Enter or a click fills the draft only, and Escape dismisses suggestions. Down-arrow in an empty Description shows the last five entries. Save still commits the edit. Save is disabled for blank descriptions; Cancel/Escape discards changes. Completed entries also allow Date and Duration (Clock/Unit patterns, 1 second to 24 hours for timing edits). Start keeps its clock time on the selected date and End follows the duration. If this would cross midnight, Start moves backward so End is midnight ending that date; exactly 24 hours runs midnight-to-midnight. Stop a running timer before editing Date/Duration. Description-only saves preserve timing, including older large durations; Created never changes. If an entry has no Start, timing edits use midnight. Right-click also offers removal (after confirmation), or stopping a running entry. The row's ▶ button starts a new timer with that description when no timer is running; ■ stops the running entry." Margin="0,8,0,0" />
                <TextBlock Text="Timers and the tray" Style="{StaticResource SectionHeading}" />
                <TextBlock Text="Enter a description and click Start; click Stop when finished. A blank description uses your default timer text, configurable under Edit. Editing a running entry's description in the list popup keeps its timer running and updates the main/tray descriptions when saved." />
                <TextBlock Text="Closing or minimizing the main window hides it to the tray. Click the tray icon for the mini window; Open App restores the main window. Use File → Exit or the tray's Exit command to quit." Margin="0,8,0,0" />
                <TextBlock Text="Browsing, filtering, and sorting" Style="{StaticResource SectionHeading}" />
                <TextBlock Text="Applied filter/sort selections restore on your next launch. Pending selections are saved separately on close/exit and still need Apply; Reset saves the defaults." Margin="0,0,0,8" />
                <TextBlock Text="Older week and Newer week browse Monday–Sunday pages. Description search and sorting stay visible; click Filters for From/To dates (inclusive) and status. The Filters count shows applied conditions. Changes pending means your draft has not been applied yet. Click Apply to show the newest matching week. Filters and sorting stay active while you change weeks; Reset restores defaults. Sorting applies within each daily group. Empty weeks remain navigable, and totals reflect matching completed entries." />
                <TextBlock Text="Exporting" Style="{StaticResource SectionHeading}" />
                <TextBlock Text="Import/Export → Export first offers a date range. Leave it off to export all completed entries, or enable it and choose inclusive From/To local dates (either boundary may be blank). Dates use Start, then End or Created when needed. This is independent of the current list filters/week. Continue then opens the save-file dialog to choose the directory and filename. Running entries are excluded." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel></Border>
</Window>
