<Window x:Class="TimeTracker.App.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Heading}" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource ScaledWindowStyle}">
    <Border Style="{StaticResource SurfaceStyle}" Margin="16">
        <StackPanel>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" IsDefault="True" Margin="0,0,8,0" Click="OnCancelClick" />
                <Button Content="{Binding ConfirmText}" Style="{StaticResource StopButtonStyle}" Click="OnConfirmClick" AutomationProperties.AutomationId="ConfirmDestructiveAction" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
