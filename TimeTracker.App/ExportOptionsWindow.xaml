<Window x:Class="TimeTracker.App.ExportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export entries" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource ScaledWindowStyle}">
    <Border Style="{StaticResource SurfaceStyle}" Margin="16">
        <StackPanel>
            <TextBlock Text="Export entries" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="Export all completed entries, or choose a date range. Running entries are excluded." TextWrapping="Wrap" Margin="0,10,0,16" />
            <CheckBox Content="Limit to a date range" IsChecked="{Binding UseDateRange}" AutomationProperties.AutomationId="ExportUseDateRange" Margin="0,0,0,12" />
            <Grid IsEnabled="{Binding UseDateRange}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="From date (optional)" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" /><DatePicker x:Name="FromPicker" SelectedDate="{Binding FromDate}" DateValidationError="OnDateValidationError" SelectedDateChanged="OnFromDateChanged" AutomationProperties.AutomationId="ExportFromDate" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="To date (inclusive, optional)" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" /><DatePicker x:Name="ToPicker" SelectedDate="{Binding ToDate}" DateValidationError="OnDateValidationError" SelectedDateChanged="OnToDateChanged" AutomationProperties.AutomationId="ExportToDate" /></StackPanel>
            </Grid>
            <TextBlock Text="Dates use the entry's local Start date, falling back to End or Created. Blank dates leave that boundary open." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,12" AutomationProperties.AutomationId="ExportRangeError" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="0,0,8,0" />
                <Button Content="Continue…" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="OnContinueClick" AutomationProperties.AutomationId="ExportContinueButton" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
