<Window x:Class="TimeTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TimeTracker.App.Converters"
        xmlns:helpers="clr-namespace:TimeTracker.App.Helpers"
        Title="{Binding WindowTitle}" Height="800" Width="1100" MinWidth="960" MinHeight="550"
        WindowStartupLocation="CenterScreen" Style="{StaticResource ScaledWindowStyle}"
        Closing="OnClosing" StateChanged="OnStateChanged">
    <Window.TaskbarItemInfo><TaskbarItemInfo ProgressState="{Binding TaskbarProgressState}" ProgressValue="{Binding TaskbarProgressValue}" /></Window.TaskbarItemInfo>
    <Window.Resources>
        <conv:EntryGroupHeaderConverter x:Key="EntryGroupHeaderConverter" />
        <conv:DateGroupLabelConverter x:Key="DateGroupLabelConverter" />
        <DataTemplate x:Key="SuggestionItemTemplate"><TextBlock Text="{Binding}" Padding="8,5" /></DataTemplate>
        <CollectionViewSource x:Key="GroupedEntries" Source="{Binding Entries}">
            <CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="GroupDate" /></CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions><componentModel:SortDescription PropertyName="GroupDate" Direction="Descending" xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase" /></CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}"><Setter Property="Margin" Value="0,0,0,4" /></Style>
        <Style x:Key="InlineError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Menu Padding="12,5">
            <MenuItem Header="_File"><!-- Startup registration disabled (AR-039). <MenuItem x:Name="LaunchAtStartupMenuItem" Header="Launch at _startup" IsCheckable="True" Click="OnLaunchAtStartupClick" ToolTip="Launch quietly in the tray when you sign in to Windows." AutomationProperties.AutomationId="LaunchAtStartupMenuItem" /><Separator /> --><MenuItem Header="E_xit completely (including tray)" Click="OnExitClick" ToolTip="Completely closes TimeTracker and removes its tray icon. The app will no longer run in the background. Closing the main window with X only hides it to the tray." AutomationProperties.HelpText="Completely closes TimeTracker, including its tray icon and background operation." /></MenuItem>
            <MenuItem Header="_Edit"><MenuItem Header="Default _Timer Text..." Click="OnDefaultTimerTextClick" /><Separator /><MenuItem Header="_Clear All Data" Command="{Binding ClearAllDataCommand}" /></MenuItem>
            <MenuItem Header="_View"><MenuItem Header="Show/Hide Lock/Unlock History" Click="OnScreenEventsClick" /></MenuItem>
            <MenuItem Header="_Import/Export"><MenuItem Header="_Import..." Command="{Binding ImportCommand}" /><MenuItem Header="_Export..." Command="{Binding ExportCommand}" /><Separator /><MenuItem Header="Import/Export _History" Click="OnImportExportHistoryClick" /></MenuItem>
            <MenuItem Header="_Help"><MenuItem Header="_Usage..." Click="OnUsageClick" AutomationProperties.AutomationId="UsageMenuItem" /><MenuItem Header="_About" Click="OnAboutClick" /></MenuItem>
        </Menu>

        <!-- Timer remains accessible while the composer or list scrolls. -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceStyle}" Margin="16,4,16,6" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="TimeTracker" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="What are you working on?" Style="{StaticResource MutedTextStyle}" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" /></StackPanel>
                <Grid Grid.Row="1" Margin="0,0,16,0">
                    <TextBox x:Name="TimerDescriptionTextBox" Tag="Timer" PreviewKeyDown="OnDescriptionPreviewKeyDown" PreviewKeyUp="OnDescriptionPreviewKeyUp" Text="{Binding TimerDescription, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="What are you working on?" ToolTip="What are you working on?"
                             GotFocus="OnTimerDescriptionGotFocus" LostFocus="OnTimerDescriptionLostFocus" TextChanged="OnTimerDescriptionTextChanged"
                             Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />
                    <TextBlock Text="{Binding RunningStatusText}" ToolTip="{Binding RunningStatusText}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Popup x:Name="TimerSuggestionsPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=TimerDescriptionTextBox}" IsOpen="{Binding IsTimerSuggestionsOpen, Mode=TwoWay}" StaysOpen="False">
                        <Border Style="{StaticResource SurfaceStyle}" Padding="4" MaxHeight="220"><ListBox x:Name="TimerSuggestionsListBox" Focusable="False" SelectedIndex="{Binding TimerSuggestionIndex, Mode=TwoWay}" KeyboardNavigation.TabNavigation="None" ItemsSource="{Binding TimerSuggestions}" ItemTemplate="{StaticResource SuggestionItemTemplate}" PreviewMouseLeftButtonDown="OnTimerSuggestionSelected" /></Border>
                    </Popup>
                </Grid>
                <TextBlock Grid.Column="1" Text="Initial duration" Style="{StaticResource MutedTextStyle}" Margin="0,0,20,4" Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />
                <Grid Grid.Column="1" Grid.Row="1" Width="150" Margin="0,0,20,0" Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                    <TextBox x:Name="TimerInitialDurationTextBox" PreviewKeyDown="OnTimerStartPreviewKeyDown" Text="{Binding TimerInitialDuration, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional: same formats as manual duration. Blank or 0 starts from zero; maximum 23:59:59. Press Enter to start when the description has text." AutomationProperties.AutomationId="TimerInitialDurationTextBox" AutomationProperties.Name="Initial timer duration" />
                    <TextBlock Text="00:00:00" Foreground="{DynamicResource MutedBrush}" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TimerInitialDurationTextBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Margin="0,0,20,0" Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding RunningElapsedText}" FontSize="32" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextAlignment="Right" />
                    <TextBlock Text="In progress" Foreground="{DynamicResource RunningTextBrush}" TextAlignment="Right" />
                </StackPanel>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding TimerError}" Style="{StaticResource InlineError}" AutomationProperties.AutomationId="TimerError" />
                <Button Grid.Column="2" Grid.Row="1" x:Name="StartTimerButton" AutomationProperties.AutomationId="StartTimerButton" AutomationProperties.Name="Start timer" Command="{Binding StartTimerCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlayGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="12" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="Start timer" /></StackPanel>
                </Button>
                <Button Grid.Column="2" Grid.Row="1" x:Name="StopTimerButton" AutomationProperties.AutomationId="StopTimerButton" AutomationProperties.Name="Stop timer" Command="{Binding StopTimerCommand}" Style="{StaticResource StopButtonStyle}" VerticalAlignment="Center" Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource StopGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="Stop timer" /></StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="16,0,16,0" x:Name="ComposerSpace">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="100" /></Grid.RowDefinitions>
            <Border Style="{StaticResource SurfaceStyle}" Margin="0,0,0,6" Padding="16,4" MaxHeight="{Binding ActualHeight, ElementName=ComposerSpace, Converter={StaticResource ComposerHeightConverter}}">
                <Expander x:Name="ManualEntryExpander" IsExpanded="{Binding IsManualEntryExpanded, Mode=TwoWay}" Collapsed="OnManualEntryCollapsed" AutomationProperties.AutomationId="ManualEntryExpander" AutomationProperties.Name="Manual entry">
                    <Expander.Header><TextBlock Text="Manual entry" Style="{StaticResource SectionTitleStyle}" ToolTip="Expand or collapse manual entry to make more room for the list." /></Expander.Header>
                    <ScrollViewer x:Name="ManualEntryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <Grid MinWidth="780">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="3.5*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Button Grid.Column="4" Content="Cancel edit" Command="{Binding CancelEditCommand}" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Grid.Row="1" FontSize="13" FontWeight="SemiBold" Grid.ColumnSpan="5" Margin="0,0,0,4" TextWrapping="Wrap"><Run Text="By duration " /><Span FontSize="12" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}"><Run Text="(34 = minutes · 1.5 = hours · 1 second–23:59:59. " /><Hyperlink Click="OnUsageClick">Duration help</Hyperlink><Run Text=")" /></Span></TextBlock>
                        <StackPanel Grid.Row="2" Margin="0,0,8,0"><TextBlock Text="Start Date" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding ManualStartDate}" DateValidationError="OnManualDateValidationError" AutomationProperties.AutomationId="DurationStartDatePicker" /></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ManualDescriptionTextBox" Tag="Manual" PreviewKeyDown="OnDescriptionPreviewKeyDown" PreviewKeyUp="OnDescriptionPreviewKeyUp" AutomationProperties.AutomationId="ManualDescriptionTextBox" Text="{Binding ManualDescription, UpdateSourceTrigger=PropertyChanged}" GotFocus="OnManualDescriptionGotFocus" LostFocus="OnManualDescriptionLostFocus" TextChanged="OnManualDescriptionTextChanged" />
                            <Popup x:Name="ManualSuggestionsPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=ManualDescriptionTextBox}" IsOpen="{Binding IsManualSuggestionsOpen, Mode=TwoWay}" StaysOpen="False"><Border Style="{StaticResource SurfaceStyle}" Padding="4" MaxHeight="220"><ListBox x:Name="ManualSuggestionsListBox" Focusable="False" SelectedIndex="{Binding ManualSuggestionIndex, Mode=TwoWay}" KeyboardNavigation.TabNavigation="None" ItemsSource="{Binding ManualSuggestions}" ItemTemplate="{StaticResource SuggestionItemTemplate}" PreviewMouseLeftButtonDown="OnManualSuggestionSelected" /></Border></Popup>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,8,0"><TextBlock Text="Duration" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ManualDurationTextBox" AutomationProperties.AutomationId="ManualDurationTextBox" Text="{Binding ManualDuration, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 second–23:59:59. 34 = minutes; 1.5 = hours; 1:02:30 = hours:minutes:seconds." /></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="4">
                            <TextBlock Text="Action" Style="{StaticResource FieldLabel}" Visibility="Hidden" />
                            <Button x:Name="AddDurationButton" AutomationProperties.AutomationId="AddDurationButton" Content="{Binding AddButtonText}" Command="{Binding AddDurationEntryCommand}" Height="{Binding ActualHeight, ElementName=ManualDurationTextBox}" MinWidth="100" MinHeight="28" Padding="12,2" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="5" Text="{Binding ManualDurationError}" Style="{StaticResource InlineError}" AutomationProperties.AutomationId="ManualDurationError" />
                        <Border Grid.Row="5" Grid.ColumnSpan="5" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,4"><TextBlock Text="By start and end time" FontSize="13" FontWeight="SemiBold" /></Border>
                        <StackPanel Grid.Row="6" Margin="0,0,8,0"><TextBlock Text="Start Date" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding RangeStartDate}" DateValidationError="OnManualDateValidationError" AutomationProperties.AutomationId="RangeStartDatePicker" /></StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="RangeDescriptionTextBox" Tag="Range" PreviewKeyDown="OnDescriptionPreviewKeyDown" PreviewKeyUp="OnDescriptionPreviewKeyUp" AutomationProperties.AutomationId="RangeDescriptionTextBox" Text="{Binding RangeDescription, UpdateSourceTrigger=PropertyChanged}" GotFocus="OnManualDescriptionGotFocus" LostFocus="OnRangeDescriptionLostFocus" />
                            <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=RangeDescriptionTextBox}" IsOpen="{Binding IsRangeSuggestionsOpen, Mode=TwoWay}" StaysOpen="False"><Border Style="{StaticResource SurfaceStyle}" Padding="4" MaxHeight="220"><ListBox x:Name="RangeSuggestionsListBox" Focusable="False" SelectedIndex="{Binding RangeSuggestionIndex, Mode=TwoWay}" KeyboardNavigation.TabNavigation="None" ItemsSource="{Binding RangeSuggestions}" ItemTemplate="{StaticResource SuggestionItemTemplate}" PreviewMouseLeftButtonDown="OnRangeSuggestionSelected" /></Border></Popup>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Start Time" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding ManualStartTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RangeStartTimeTextBox" ToolTip="24-hour time: 09:30 or 09:30:00." /></StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="End Time" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding ManualEndTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RangeEndTimeTextBox" ToolTip="After start, on the same day. Example: 17:30." /></StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="4">
                            <TextBlock Text="Action" Style="{StaticResource FieldLabel}" Visibility="Hidden" />
                            <Button x:Name="AddRangeButton" AutomationProperties.AutomationId="AddRangeButton" Content="{Binding RangeButtonText}" Command="{Binding AddManualRangeEntryCommand}" Height="{Binding ActualHeight, ElementName=ManualDurationTextBox}" MinWidth="100" MinHeight="28" Padding="12,2" />
                        </StackPanel>
                        <TextBlock Grid.Row="7" Grid.ColumnSpan="5" Text="{Binding ManualRangeError}" Style="{StaticResource InlineError}" AutomationProperties.AutomationId="ManualRangeError" />
                    </Grid>
                    </ScrollViewer>
                </Expander>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource SurfaceStyle}" Padding="12,6,12,12">
                <Grid x:Name="EntriesSpace">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ScrollViewer x:Name="EntryHeaderScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="{Binding ActualHeight, ElementName=EntriesSpace, Converter={StaticResource ComposerHeightConverter}, ConverterParameter=Headers}">
                    <Grid MinWidth="700">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Left" Text="Entries" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding WeekTotalText}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" /></DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Description contains" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding FilterDescription, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EntryDescriptionFilter" /></StackPanel>
                        <ToggleButton Grid.Column="1" Content="{Binding FiltersButtonText}" IsChecked="{Binding IsFiltersExpanded}" AutomationProperties.AutomationId="EntryFiltersToggle" Margin="0,0,8,0" Padding="10,3" VerticalAlignment="Bottom" MinHeight="28" />
                        <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Sort within day" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding EntrySortOptions}" SelectedItem="{Binding SelectedEntrySort}" Width="112" AutomationProperties.AutomationId="EntrySortField" /></StackPanel>
                        <CheckBox Grid.Column="3" Content="Descending" IsChecked="{Binding SortDescending}" VerticalAlignment="Bottom" Margin="0,0,12,8" />
                        <Button Grid.Column="4" Content="Apply" Command="{Binding ApplyEntryFiltersCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" AutomationProperties.AutomationId="ApplyEntryFiltersButton" Margin="0,0,8,0" MinHeight="28" Padding="12,3" />
                        <Button Grid.Column="5" Content="Reset" Command="{Binding ResetEntryFiltersCommand}" VerticalAlignment="Bottom" AutomationProperties.AutomationId="ResetEntryFiltersButton" MinHeight="28" Padding="12,3" />
                    </Grid>
                    <StackPanel Grid.Row="2">
                        <WrapPanel x:Name="AdvancedFiltersPanel" Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,4,0,6">
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="From date" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding FilterFromDate}" Width="150" AutomationProperties.AutomationId="EntryFromDateFilter" /></StackPanel>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="To date (inclusive)" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding FilterToDate}" Width="150" AutomationProperties.AutomationId="EntryToDateFilter" /></StackPanel>
                            <StackPanel><TextBlock Text="Status" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" Width="130" AutomationProperties.AutomationId="EntryStatusFilter" /></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Changes pending · click Apply to refresh results" Style="{StaticResource MutedTextStyle}" Visibility="{Binding HasPendingEntryQuery, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding EntryQueryError}" Style="{StaticResource InlineError}" />
                        <TextBlock Text="{Binding EntryPreferencesError}" Style="{StaticResource InlineError}" />
                    </StackPanel>
                    </Grid>
                    </ScrollViewer>
                    <DockPanel Grid.Row="1" Margin="0,4,0,8"><Button DockPanel.Dock="Left" Content="‹ Older week" Command="{Binding OlderWeekCommand}" AutomationProperties.AutomationId="OlderWeekButton" /><Button DockPanel.Dock="Right" Content="Newer week ›" Command="{Binding NewerWeekCommand}" AutomationProperties.AutomationId="NewerWeekButton" /><TextBlock Text="{Binding WeekPageText}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" AutomationProperties.AutomationId="WeekPageLabel" Margin="8,0" /></DockPanel>
                    <Grid Grid.Row="2">
                        <ListView x:Name="EntriesListView" AutomationProperties.AutomationId="EntriesListView" ItemsSource="{Binding Source={StaticResource GroupedEntries}}" SelectedItem="{Binding SelectedEntry}" SelectionMode="Single" AlternationCount="2" PreviewMouseLeftButtonDown="OnEntryPreviewMouseLeftButtonDown" MouseDoubleClick="OnEntryDoubleClick">
                            <ListView.View><GridView>
                                <GridViewColumn helpers:EntryGridLayout.ColumnKey="id" Header="ID" Width="42"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Id}" HorizontalAlignment="Left" TextAlignment="Left" Margin="2,3" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn helpers:EntryGridLayout.ColumnKey="timer" Header="Timer" Width="52"><GridViewColumn.CellTemplate><DataTemplate>
                                    <Button Click="OnPlayEntryClick" AutomationProperties.AutomationId="EntryTimerButton" Padding="8,4" MinHeight="28" HorizontalAlignment="Center">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}"><Setter Property="ToolTip" Value="Start a new timer with this description" /><Setter Property="AutomationProperties.Name" Value="Start timer from entry" /><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="ToolTip" Value="Stop this running timer" /><Setter Property="AutomationProperties.Name" Value="Stop running entry" /><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        <Path Width="10" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="{StaticResource PlayGeometry}" /><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Data" Value="{StaticResource StopGeometry}" /></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                                    </Button>
                                </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn x:Name="DescriptionColumn" helpers:EntryGridLayout.ColumnKey="description" Header="Description" Width="235"><GridViewColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Description, Mode=OneWay}" IsReadOnly="True" ContextMenu="{x:Null}" ToolTip="{Binding Description}" AutomationProperties.AutomationId="EntryDescriptionText" Background="Transparent" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}" BorderThickness="0" Padding="0" MinHeight="0" Margin="0,3" VerticalAlignment="Center"><TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" /></ControlTemplate></TextBox.Template></TextBox></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn helpers:EntryGridLayout.ColumnKey="start" Header="Start" Width="170"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StartLocalCompactText}" FontSize="13" Margin="2,3" HorizontalAlignment="Left" TextAlignment="Left" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn helpers:EntryGridLayout.ColumnKey="end" Header="End" Width="170"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding EndLocalCompactText}" FontSize="13" Margin="2,3" HorizontalAlignment="Left" TextAlignment="Left" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn helpers:EntryGridLayout.ColumnKey="duration" Header="Duration" Width="125"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DurationText}" HorizontalAlignment="Left" TextAlignment="Left" Typography.NumeralAlignment="Tabular" Margin="2,3" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn helpers:EntryGridLayout.ColumnKey="created" Header="Created" Width="170"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CreatedLocalCompactText}" FontSize="13" Margin="2,3" HorizontalAlignment="Left" TextAlignment="Left" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn helpers:EntryGridLayout.ColumnKey="modified" Header="Modified" Width="170"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ModifiedLocalCompactText}" FontSize="13" Margin="2,3" HorizontalAlignment="Left" TextAlignment="Left" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            </GridView></ListView.View>
                            <ListView.GroupStyle><GroupStyle AlternationCount="2">
                                <GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><StackPanel><ContentPresenter /><ItemsPresenter Margin="2,0,0,0" /></StackPanel></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle>
                                <GroupStyle.HeaderTemplate><DataTemplate><Border Background="{DynamicResource CanvasBrush}" Margin="0,4,0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name, Converter={StaticResource DateGroupLabelConverter}}" FontWeight="SemiBold" Margin="8,4" /><TextBlock TextAlignment="Left" Foreground="{DynamicResource MutedBrush}" Margin="4,4,8,4"><TextBlock.Text><MultiBinding Converter="{StaticResource EntryGroupHeaderConverter}" ConverterParameter="Total"><Binding /><Binding Path="ItemCount" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListView.GroupStyle>
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                <Setter Property="ContextMenu"><Setter.Value><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="_Copy description" Command="{Binding PlacementTarget.Tag.CopyEntryDescriptionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" /><MenuItem Header="_Edit entry" AutomationProperties.AutomationId="EditEntryMenuItem" Command="{Binding PlacementTarget.Tag.EditEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" /><Separator /><MenuItem Header="_Remove entry" AutomationProperties.AutomationId="RemoveEntryMenuItem" Command="{Binding PlacementTarget.Tag.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" /><MenuItem Header="_Stop running entry" AutomationProperties.AutomationId="StopEntryMenuItem" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding PlacementTarget.Tag.StopEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" /></ContextMenu></Setter.Value></Setter>
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="Padding" Value="0,4" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><Grid Background="{TemplateBinding Background}"><Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False" /><GridViewRowPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}" /></Grid></Border></ControlTemplate></Setter.Value></Setter>
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource AlternateRowBrush}" /></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Background" Value="{DynamicResource RunningBrush}" /><Setter Property="Foreground" Value="{DynamicResource RunningTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RunningBorderBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="AutomationProperties.ItemStatus" Value="In progress" /></DataTrigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" /><Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}" /></Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsRunning}" Value="True" /><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="BorderBrush" Value="{DynamicResource RunningBorderBrush}" /></MultiDataTrigger>
                                </Style.Triggers>
                            </Style></ListView.ItemContainerStyle>
                        </ListView>
                        <Border Background="{DynamicResource SurfaceBrush}" Margin="2" Visibility="{Binding ShowEmptyEntries, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding EmptyEntriesText}" FontWeight="SemiBold" TextAlignment="Center" Margin="12" /><Button Content="Reset filters" Command="{Binding ResetEntryFiltersCommand}" Visibility="{Binding HasActiveEntryFilters, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Center" /></StackPanel></Border>
                        <Border Background="{DynamicResource SurfaceBrush}" Margin="2" Visibility="{Binding IsEntriesLoading, Converter={StaticResource BoolToVisibilityConverter}}"><TextBlock Text="Loading entries…" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    </Grid>
                    <TextBlock Grid.Row="3" Text="{Binding EntryPageSummary}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="EntryPageSummary" Margin="0,8,0,0" />
                </Grid>
            </Border>
        </Grid>
        <Expander Grid.Row="3" Header="Stored locally · database details" Margin="20,6,20,8" Foreground="{DynamicResource MutedBrush}" FontSize="13"><TextBox Text="{Binding DatabasePathText}" IsReadOnly="True" ToolTip="Select and copy the full database path" Margin="0,6,0,0" /></Expander>
    </Grid>
</Window>
