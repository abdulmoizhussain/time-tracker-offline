<Window x:Class="TimeTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TimeTracker.App.ViewModels"
        xmlns:conv="clr-namespace:TimeTracker.App.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="800"
        Width="1100"
        MinWidth="960"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ScaledWindowStyle}"
        Closing="OnClosing"
        StateChanged="OnStateChanged">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding TaskbarProgressState}" ProgressValue="{Binding TaskbarProgressValue}" />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <conv:EntryGroupHeaderConverter x:Key="EntryGroupHeaderConverter" />

        <DataTemplate x:Key="SuggestionItemTemplate" DataType="{x:Type system:String}" xmlns:system="clr-namespace:System;assembly=mscorlib">
            <TextBlock Text="{Binding}" Padding="4,2" />
        </DataTemplate>

        <CollectionViewSource x:Key="GroupedEntries" Source="{Binding Entries}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupDate" />
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <componentModel:SortDescription PropertyName="GroupDate" Direction="Descending" xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Padding="4">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Default _Timer Text..." Click="OnDefaultTimerTextClick" />
                <Separator />
                <MenuItem Header="_Clear All Data" Command="{Binding ClearAllDataCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Show/Hide Lock/Unlock History" Click="OnScreenEventsClick" />
            </MenuItem>
            <MenuItem Header="_Import/Export">
                <MenuItem Header="_Import..." Command="{Binding ImportCommand}" />
                <MenuItem Header="_Export..." Command="{Binding ExportCommand}" />
                <Separator />
                <MenuItem Header="Import/Export _History" Click="OnImportExportHistoryClick" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Usage..." Click="OnUsageClick" AutomationProperties.AutomationId="UsageMenuItem" />
                <MenuItem Header="_About" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <StackPanel Grid.Row="1" Margin="12,8,12,4">
            <TextBlock Text="Offline Time Tracker" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding RunningStatusText}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{Binding IsTimerRunning, Converter={StaticResource RunningForegroundConverter}}" />
            <TextBlock Text="{Binding RunningElapsedText, StringFormat='Elapsed: {0}'}"
                       HorizontalAlignment="Center"
                       Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                       Margin="0,2,0,0" />
            <Grid Margin="0,8,0,0" Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Running task description" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding RunningDescription, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="RunningDescriptionTextBox" Padding="6,4">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SaveRunningDescriptionCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="2" Content="Save" Command="{Binding SaveRunningDescriptionCommand}"
                        AutomationProperties.AutomationId="SaveRunningDescriptionButton" Margin="8,0,0,0" Padding="12,4" />
            </Grid>
        </StackPanel>

        <!-- TimerSection -->
        <Grid Grid.Row="2" Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="TimerDescriptionTextBox"
                         Grid.Row="0"
                         Text="{Binding TimerDescription, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Padding="6,4"
                         GotFocus="OnTimerDescriptionGotFocus"
                         LostFocus="OnTimerDescriptionLostFocus"
                         TextChanged="OnTimerDescriptionTextChanged" />
                <Popup x:Name="TimerSuggestionsPopup"
                       Grid.Row="1"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=TimerDescriptionTextBox}"
                       IsOpen="{Binding IsTimerSuggestionsOpen, Mode=TwoWay}"
                       StaysOpen="False">
                    <Border Background="White" BorderBrush="Gray" BorderThickness="1">
                        <ListBox ItemsSource="{Binding TimerSuggestions}"
                                 ItemTemplate="{StaticResource SuggestionItemTemplate}"
                                 MouseLeftButtonUp="OnTimerSuggestionSelected" />
                    </Border>
                </Popup>
            </Grid>
            <Button Grid.Column="1"
                    x:Name="StartTimerButton"
                    AutomationProperties.AutomationId="StartTimerButton"
                    Content="Start"
                    Command="{Binding StartTimerCommand}"
                    Padding="16,6"
                    Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />
            <Button Grid.Column="1"
                    x:Name="StopTimerButton"
                    AutomationProperties.AutomationId="StopTimerButton"
                    Content="Stop"
                    Command="{Binding StopTimerCommand}"
                    Padding="16,6"
                    Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>


        <!-- ManualEntrySection -->
        <Grid Grid.Row="3" Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="Add by duration" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Description" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Start Date" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Duration" Margin="0,0,0,4" />
            <Button Grid.Row="0" Grid.Column="5" Content="Cancel edit" Command="{Binding CancelEditCommand}"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="ManualDescriptionTextBox"
                         AutomationProperties.AutomationId="ManualDescriptionTextBox"
                         Grid.Row="0"
                         Text="{Binding ManualDescription, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Padding="6,4"
                         GotFocus="OnManualDescriptionGotFocus"
                         LostFocus="OnManualDescriptionLostFocus"
                         TextChanged="OnManualDescriptionTextChanged" />
                <Popup x:Name="ManualSuggestionsPopup"
                       Grid.Row="1"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=ManualDescriptionTextBox}"
                       IsOpen="{Binding IsManualSuggestionsOpen, Mode=TwoWay}"
                       StaysOpen="False">
                    <Border Background="White" BorderBrush="Gray" BorderThickness="1">
                        <ListBox ItemsSource="{Binding ManualSuggestions}"
                                 ItemTemplate="{StaticResource SuggestionItemTemplate}"
                                 MouseLeftButtonUp="OnManualSuggestionSelected" />
                    </Border>
                </Popup>
            </Grid>
            <DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding ManualStartDate}"
                        AutomationProperties.AutomationId="DurationStartDatePicker" VerticalContentAlignment="Center" Padding="6,4" Margin="0,0,8,0" />
            <TextBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" x:Name="ManualDurationTextBox" AutomationProperties.AutomationId="ManualDurationTextBox" Text="{Binding ManualDuration}" VerticalContentAlignment="Center" Padding="6,4" Margin="0,0,8,0" />
            <Button Grid.Row="2" Grid.Column="5" x:Name="AddDurationButton" AutomationProperties.AutomationId="AddDurationButton" Content="{Binding AddButtonText}" Command="{Binding AddDurationEntryCommand}" Padding="12,6" />

            <TextBlock Grid.Row="3" Grid.ColumnSpan="6" Text="Add by start and end time" FontWeight="SemiBold" Margin="0,12,0,6" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Description" Margin="0,0,0,4" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="Start Date" Margin="0,0,0,4" />
            <TextBlock Grid.Row="4" Grid.Column="2" Text="Start Time" Margin="0,0,0,4" />
            <TextBlock Grid.Row="4" Grid.Column="3" Text="End Time" Margin="0,0,0,4" />
            <Grid Grid.Row="5" Grid.Column="0" Margin="0,0,8,0">
                <TextBox x:Name="RangeDescriptionTextBox" AutomationProperties.AutomationId="RangeDescriptionTextBox"
                         Text="{Binding RangeDescription, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="6,4"
                         GotFocus="OnManualDescriptionGotFocus" LostFocus="OnRangeDescriptionLostFocus" />
                <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=RangeDescriptionTextBox}"
                       IsOpen="{Binding IsRangeSuggestionsOpen, Mode=TwoWay}" StaysOpen="False">
                    <Border Background="White" BorderBrush="Gray" BorderThickness="1">
                        <ListBox ItemsSource="{Binding RangeSuggestions}" ItemTemplate="{StaticResource SuggestionItemTemplate}"
                                 MouseLeftButtonUp="OnRangeSuggestionSelected" />
                    </Border>
                </Popup>
            </Grid>
            <DatePicker Grid.Row="5" Grid.Column="1" SelectedDate="{Binding RangeStartDate}"
                        AutomationProperties.AutomationId="RangeStartDatePicker" VerticalContentAlignment="Center" Padding="6,4" Margin="0,0,8,0" />
            <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding ManualStartTime}"
                     AutomationProperties.AutomationId="RangeStartTimeTextBox" VerticalContentAlignment="Center" Padding="6,4" Margin="0,0,8,0" />
            <TextBox Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="2" Text="{Binding ManualEndTime}"
                     AutomationProperties.AutomationId="RangeEndTimeTextBox" VerticalContentAlignment="Center" Padding="6,4" Margin="0,0,8,0" />
            <Button Grid.Row="5" Grid.Column="5" x:Name="AddRangeButton" AutomationProperties.AutomationId="AddRangeButton"
                    Content="{Binding RangeButtonText}" Command="{Binding AddManualRangeEntryCommand}" Padding="12,6" />
        </Grid>


        <!-- EntriesList -->
        <Grid Grid.Row="4" Margin="12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                <StackPanel Margin="0,0,8,4">
                    <TextBlock Text="Description contains" />
                    <TextBox Text="{Binding FilterDescription, UpdateSourceTrigger=PropertyChanged}" Width="180"
                             AutomationProperties.AutomationId="EntryDescriptionFilter" Padding="4" />
                </StackPanel>
                <StackPanel Margin="0,0,8,4">
                    <TextBlock Text="From date" />
                    <DatePicker SelectedDate="{Binding FilterFromDate}" Width="140" AutomationProperties.AutomationId="EntryFromDateFilter" />
                </StackPanel>
                <StackPanel Margin="0,0,8,4">
                    <TextBlock Text="To date (inclusive)" />
                    <DatePicker SelectedDate="{Binding FilterToDate}" Width="140" AutomationProperties.AutomationId="EntryToDateFilter" />
                </StackPanel>
                <StackPanel Margin="0,0,8,4">
                    <TextBlock Text="Status" />
                    <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" Width="105"
                              AutomationProperties.AutomationId="EntryStatusFilter" />
                </StackPanel>
                <StackPanel Margin="0,0,8,4">
                    <TextBlock Text="Sort within day" />
                    <ComboBox ItemsSource="{Binding EntrySortOptions}" SelectedItem="{Binding SelectedEntrySort}" Width="105"
                              AutomationProperties.AutomationId="EntrySortField" />
                </StackPanel>
                <CheckBox Content="Descending" IsChecked="{Binding SortDescending}" VerticalAlignment="Bottom" Margin="0,0,8,8" />
                <Button Content="Apply" Command="{Binding ApplyEntryFiltersCommand}" Padding="10,4" Margin="0,0,8,4"
                        VerticalAlignment="Bottom" AutomationProperties.AutomationId="ApplyEntryFiltersButton" />
                <Button Content="Reset" Command="{Binding ResetEntryFiltersCommand}" Padding="10,4" Margin="0,0,0,4"
                        VerticalAlignment="Bottom" AutomationProperties.AutomationId="ResetEntryFiltersButton" />
            </WrapPanel>
            <DockPanel Grid.Row="1" Margin="0,0,0,6">
                <Button DockPanel.Dock="Left" Content="← Older week" Command="{Binding OlderWeekCommand}" Padding="8,4"
                        AutomationProperties.AutomationId="OlderWeekButton" />
                <Button DockPanel.Dock="Right" Content="Newer week →" Command="{Binding NewerWeekCommand}" Padding="8,4"
                        AutomationProperties.AutomationId="NewerWeekButton" />
                <TextBlock Text="{Binding WeekPageText}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="WeekPageLabel" Margin="8,0" />
            </DockPanel>
        <ListView Grid.Row="2"
                  AutomationProperties.AutomationId="EntriesListView"
                  ItemsSource="{Binding Source={StaticResource GroupedEntries}}"
                  SelectedItem="{Binding SelectedEntry}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="50" DisplayMemberBinding="{Binding Id}" />
                    <GridViewColumn Header="▶" Width="55">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:TimeEntryViewModel}">
                                <Button Content="▶" Padding="4,0" Click="OnPlayEntryClick" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Description" Width="320" DisplayMemberBinding="{Binding Description}" />
                    <GridViewColumn Header="Start" Width="160" DisplayMemberBinding="{Binding StartLocalText}" />
                    <GridViewColumn Header="End" Width="160" DisplayMemberBinding="{Binding EndLocalText}" />
                    <GridViewColumn Header="Duration" Width="120" DisplayMemberBinding="{Binding DurationText}" />
                    <GridViewColumn Header="Created" Width="160" DisplayMemberBinding="{Binding CreatedLocalText}" />
                    <GridViewColumn Header="Modified" Width="160" DisplayMemberBinding="{Binding ModifiedLocalText}" />
                </GridView>
            </ListView.View>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="Bold"
                                       FontSize="14"
                                       Margin="4,8,0,4">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource EntryGroupHeaderConverter}">
                                        <Binding />
                                        <Binding Path="ItemCount" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="MouseDoubleClick" Handler="OnEntryDoubleClick" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
            <StackPanel Grid.Row="3" Margin="0,6,0,0">
                <TextBlock Text="Loading entries…" Visibility="{Binding IsEntriesLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="{Binding EntryPageSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="EntryPageSummary" />
                <TextBlock Text="{Binding EntryQueryError}" Foreground="DarkRed" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>


        <TextBox Grid.Row="5"
                 Text="{Binding DatabasePathText}"
                 IsReadOnly="True"
                 Margin="12,4,12,12"
                 Padding="6,4"
                 Background="Transparent"
                 BorderThickness="0" />
    </Grid>
</Window>

