<Window x:Class="TimeTracker.App.EditEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit entry" Width="600" Height="420" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner" Style="{StaticResource ScaledWindowStyle}">
    <Border Style="{StaticResource SurfaceStyle}" Margin="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Edit entry" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Grid.Row="1" Text="{Binding StatusText}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,12" />
            <StackPanel Grid.Row="2">
                <TextBlock Text="Description" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />
                <TextBox x:Name="DescriptionTextBox" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EditEntryDescriptionTextBox" AutomationProperties.Name="Entry description"
                         PreviewKeyDown="OnDescriptionPreviewKeyDown" PreviewKeyUp="OnDescriptionPreviewKeyUp" LostFocus="OnDescriptionLostFocus">
                    <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="IsReadOnly" Value="True" /></DataTrigger></Style.Triggers></Style></TextBox.Style>
                </TextBox>
                <Popup x:Name="SuggestionsPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=DescriptionTextBox}"
                       IsOpen="{Binding IsSuggestionsOpen, Mode=TwoWay}" StaysOpen="False">
                    <Border Style="{StaticResource SurfaceStyle}" Padding="4" MaxHeight="220">
                        <ListBox x:Name="SuggestionsListBox" ItemsSource="{Binding Suggestions}" Focusable="False"
                                 SelectedIndex="{Binding SuggestionIndex, Mode=TwoWay}" KeyboardNavigation.TabNavigation="None"
                                 PreviewMouseLeftButtonDown="OnSuggestionMouseDown" AutomationProperties.AutomationId="EditEntrySuggestionsListBox">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Padding="8,5" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,12,0,0" IsEnabled="{Binding CanEditTiming}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Date" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding Date}" DateValidationError="OnDateValidationError" AutomationProperties.AutomationId="EditEntryDatePicker" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Duration" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnDurationLostFocus"
                             PreviewKeyDown="OnDurationPreviewKeyDown" AutomationProperties.AutomationId="EditEntryDurationTextBox"
                             ToolTip="Clock pattern or Unit pattern (e.g. 01:30:00 or 1h 30m). Timing edits: 1 second to 24 hours." />
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="4" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8" AutomationProperties.AutomationId="EditEntryError" />
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" IsDefault="True" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="EditEntrySaveButton" />
                <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" Margin="8,0,0,0" AutomationProperties.AutomationId="EditEntryCancelButton">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
