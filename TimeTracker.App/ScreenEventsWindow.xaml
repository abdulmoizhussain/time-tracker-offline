<Window x:Class="TimeTracker.App.ScreenEventsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TimeTracker.App.Converters"
        Title="Screen Lock/Unlock History"
        Height="560"
        Width="760"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ScaledWindowStyle}">
    <Window.Resources>
        <conv:DateGroupLabelConverter x:Key="DateGroupLabelConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Screen Lock/Unlock History" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="16,4" Margin="16,0,0,0" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding Events}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="60" DisplayMemberBinding="{Binding Id}" />
                    <GridViewColumn Header="Time" Width="200" DisplayMemberBinding="{Binding OccurredLocal, StringFormat='{}{0:g}'}" />
                    <GridViewColumn Header="Event" Width="150" DisplayMemberBinding="{Binding EventType}" />
                </GridView>
            </ListView.View>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, Converter={StaticResource DateGroupLabelConverter}}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Margin="4,8,0,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>

        <TextBlock Grid.Row="2" Text="{Binding SummaryText}" Margin="0,8,0,0" />
    </Grid>
</Window>
