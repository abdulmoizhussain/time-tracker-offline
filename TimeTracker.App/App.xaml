<Application x:Class="TimeTracker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TimeTracker.App.Converters"
             Startup="OnApplicationStartup"
             Exit="OnExit"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <system:Double x:Key="UiScaleMultiplier" xmlns:system="clr-namespace:System;assembly=mscorlib">1.0</system:Double>
            <system:Double x:Key="BaseFontSize" xmlns:system="clr-namespace:System;assembly=mscorlib">15</system:Double>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:RunningForegroundConverter x:Key="RunningForegroundConverter" />

            <Style TargetType="Window" x:Key="ScaledWindowStyle">
                <Setter Property="TextElement.FontSize" Value="{DynamicResource BaseFontSize}" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="{DynamicResource UiScaleMultiplier}" ScaleY="{DynamicResource UiScaleMultiplier}" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
            </Style>

            <Style TargetType="ListViewItem">
                <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
            </Style>

            <Style TargetType="GridViewColumnHeader">
                <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

